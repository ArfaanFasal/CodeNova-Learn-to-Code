# MongoDB Atlas connection (replace with your connection string)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/codenova?retryWrites=true&w=majority

# JWT secrets (generate strong random strings in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ADMIN_SECRET=your-admin-jwt-secret-change-in-production

# OneCompiler API (get key from https://onecompiler.com/)
ONECOMPILER_API_KEY=your-onecompiler-api-key

# Server
PORT=5000
NODE_ENV=development
